# Fill in your GCP project info and rename this file to ".env".

GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=<YOUR_PROJECT_ID>
GOOGLE_CLOUD_LOCATION=<YOUR_PROJECT_LOCATION>
GOOGLE_CLOUD_STORAGE_BUCKET=<YOUR_STORAGE_BUCKET>  # Only required for deployment on Agent Engine

# Dual-mode web gateway. Anonymous mode never calls Salesforce.
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8080
APP_SESSION_SIGNING_KEY=<AT_LEAST_32_RANDOM_BYTES>
COOKIE_SECURE=false
GATEWAY_STORAGE_BACKEND=memory

# Salesforce External Client App OAuth (only for Salesforce mode).
SFDC_LOGIN_URL=https://login.salesforce.com
SFDC_OAUTH_CLIENT_ID=<EXTERNAL_CLIENT_APP_CONSUMER_KEY>
# Set only when "Require Secret for Web Server Flow" is enabled on the ECA.
SFDC_OAUTH_CLIENT_SECRET=<EXTERNAL_CLIENT_APP_SECRET>
SFDC_MCP_URL=https://api.salesforce.com/platform/mcp/v1/platform/sobject-reads
# These defaults match the API names supplied for Account. Override if your
# custom fields use Salesforce's conventional double-underscore suffix.
SFDC_RISK_PROFILE_FIELD=RiskProfile_c
SFDC_INVESTMENT_GOALS_FIELD=InvestmentGoals_c

# Production token storage (use GATEWAY_STORAGE_BACKEND=firestore).
FIRESTORE_PROJECT=<YOUR_PROJECT_ID>
FIRESTORE_DATABASE=(default)
TOKEN_KMS_KEY_NAME=projects/<PROJECT>/locations/<LOCATION>/keyRings/<RING>/cryptoKeys/<KEY>
